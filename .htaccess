# Site-wide server rules for thilan.novalinkinnovations.com

# Custom "page not found" page
ErrorDocument 404 /404.html

# Hide files that aren't part of the website
<FilesMatch "(\.(md|py|yml|log)|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always use https:// (also works behind a proxy such as Cloudflare)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Old portfolio addresses (/HTML/...) -> the new pages, so existing links and Google rankings keep working
    RewriteRule ^HTML/?$ / [R=301,L]
    RewriteRule ^HTML/index\.html$ / [R=301,L]
    RewriteRule ^HTML/about-me\.html$ /about.html [R=301,L]
    RewriteRule ^HTML/contact\.html$ /contact.html [R=301,L]
    RewriteRule ^HTML/dela-marketplace-ux\.html$ /work/dela.html [R=301,L]
    RewriteRule ^HTML/active-care-ux\.html$ /work/active-care.html [R=301,L]
    RewriteRule ^HTML/iom-leave-app-ux\.html$ /work/iom-world.html [R=301,L]
    RewriteRule ^HTML/novalink-pm-saas\.html$ /work/novalink.html [R=301,L]
    RewriteRule ^HTML/orangehrm-redesign\.html$ /play.html [R=301,L]
    RewriteRule ^HTML/graphic-design\.html$ /play.html [R=301,L]
    RewriteRule ^HTML/ai-marketing-videos\.html$ /play.html#ai-videos [R=301,NE,L]
    RewriteRule ^HTML/mail\.php$ /mail.php [R=307,L]
    RewriteRule ^HTML/assets/(img|video)/(.*)$ /assets/$1/$2 [R=301,L]

    # Even older addresses
    RewriteRule ^Dela\.html$ /work/dela.html [R=301,L]
    RewriteRule ^active\ care\.html$ /work/active-care.html [R=301,L]
    RewriteRule ^Leave\ App\.html$ /work/iom-world.html [R=301,L]
    RewriteRule ^novalink\.html$ /work/novalink.html [R=301,L]
    RewriteRule ^OrangeHRM\.html$ /play.html [R=301,L]
    RewriteRule ^Graphic\ Desiging\.html$ /play.html [R=301,L]
    RewriteRule ^index-software-development-company\.html$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|webp|jpg|png|svg|mp4)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
